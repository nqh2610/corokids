# Database Configuration
# Sửa thông tin sau theo MySQL của bạn:
# - Thay "password" bằng mật khẩu MySQL root của bạn
# - Hoặc để trống nếu không có password: DATABASE_URL="mysql://root@localhost:3306/sorokids"
DATABASE_URL="mysql://root:@localhost:3306/sorokids"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sorokids-production-secret-key-2025"

# Google OAuth (Tùy chọn - để trống nếu không dùng)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App Environment
NODE_ENV="development"